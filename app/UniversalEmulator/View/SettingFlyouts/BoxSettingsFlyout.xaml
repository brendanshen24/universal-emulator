                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="SELECT/MODE" />
                    <TextBox
                        x:Name="SelectTextBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,4"
