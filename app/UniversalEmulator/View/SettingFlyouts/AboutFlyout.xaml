<UserControl
    x:Class="MBox.View.SettingFlyouts.AboutFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF00B2F0"
    Foreground="#FFFFFFFF">
    <StackPanel>
        <StackPanel Width="250" Margin="0,0,0,20">
            <TextBlock
                x:Uid="PolicyTextBlock"
                Margin="0,0,0,20"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
