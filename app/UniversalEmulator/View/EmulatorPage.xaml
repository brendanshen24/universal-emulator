<view:CommonPage
    x:Class="MBox.View.EmulatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MSACL.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flyouts="using:MBox.View.SettingFlyouts"
    xmlns:gamepad="using:GamePad"
    xmlns:local="using:MBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:msaclcontrols="using:MSACL.UI.Controls"
    xmlns:renderer="using:MBoxPanels"
    xmlns:view="using:MBox.View"
    xmlns:viewModel="using:MBox.ViewModel"
    x:Name="commonPage"
    Opacity="1">
    <view:CommonPage.DataContext>
        <viewModel:EmulatorPageViewModel />
    </view:CommonPage.DataContext>
    <view:CommonPage.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            FalseValue="Collapsed"
            TrueValue="Visible" />
        <converters:BoolToVisibilityConverter
            x:Key="InverseVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
        <view:BoolToGamepadEditingStatusConverter
            x:Key="BoolToGamepadEditingStatusConverter"
            FalseValue="Playing"
            TrueValue="Editing" />
        <view:EmulatorToGamePadeModeConverter x:Key="EmulatorToGamePadeModeConverter" />
        <Storyboard
            x:Key="SaveAnimation"
            x:Name="SaveAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.Opacity)">
                <DoubleAnimationUsingKeyFrames.KeyFrames>
                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.3" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                </DoubleAnimationUsingKeyFrames.KeyFrames>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </view:CommonPage.Resources>
    <Grid
        x:Name="grid"
        Background="#FF000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ApplicationViewStates">
                <VisualState x:Name="Landscape" />
                <VisualState x:Name="Filled" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <CommandBar
            x:Name="PageAppBar"
            Grid.RowSpan="2"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="10"
            Background="{StaticResource AccentColorBrush}"
            Visibility="Collapsed">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    x:Name="Back"
                    x:Uid="BackButton"
                    Icon="Back">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                </AppBarButton>
                <AppBarButton
                    x:Name="Save"
                    x:Uid="SaveButtonPhone"
                    Icon="Save">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                </AppBarButton>
                <AppBarButton
                    x:Name="Load"
                    x:Uid="LoadButtonPhone">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE159;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton
                    x:Name="FullScreen"
                    x:Uid="FullScreenToggle">
                    <AppBarToggleButton.Visibility>
                        <Binding Converter="{StaticResource InverseVisibilityConverter}" Path="IsXBoxMode" />
                    </AppBarToggleButton.Visibility>
                    <AppBarToggleButton.IsChecked>
                        <Binding Mode="OneWay" Path="IsFullScreenEnabled" />
                    </AppBarToggleButton.IsChecked>
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarToggleButton.Command>
                        <Binding Path="ToggleFullScreenCommand" />
                    </AppBarToggleButton.Command>
                </AppBarToggleButton>
                <AppBarToggleButton
                    x:Name="Sound"
                    x:Uid="SoundToggleButton"
                    Icon="Volume">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarToggleButton.IsChecked>
                        <Binding Mode="OneWay" Path="IsSoundEnabled" />
                    </AppBarToggleButton.IsChecked>
                    <AppBarToggleButton.Command>
                        <Binding Path="ToggleSoundCommand" />
                    </AppBarToggleButton.Command>
                </AppBarToggleButton>
                <AppBarToggleButton
                    x:Name="ShowGamePad"
                    x:Uid="ShowGamePadToggle"
                    Icon="Keyboard">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarToggleButton.IsChecked>
                        <Binding Path="IsGamePadEnabled" />
                    </AppBarToggleButton.IsChecked>
                    <AppBarToggleButton.Command>
                        <Binding Path="ToggleGamePadCommand" />
                    </AppBarToggleButton.Command>
                    <AppBarToggleButton.Visibility>
                        <Binding Converter="{StaticResource BoolToVisibilityConverter}" Path="IsGamePadAvailable" />
                    </AppBarToggleButton.Visibility>
                </AppBarToggleButton>
                <AppBarToggleButton
                    x:Name="SetupGamePad"
                    x:Uid="SetupGamePadToggle"
                    Icon="Repair">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarToggleButton.Visibility>
                        <Binding Converter="{StaticResource BoolToVisibilityConverter}" Path="IsGamePadEnabled" />
                    </AppBarToggleButton.Visibility>
                    <AppBarToggleButton.IsChecked>
                        <Binding Mode="TwoWay" Path="IsSetupGamepadMode" />
                    </AppBarToggleButton.IsChecked>
                </AppBarToggleButton>
                <AppBarToggleButton
                    x:Name="Blur"
                    x:Uid="BlurToggleButton">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                    <AppBarToggleButton.IsChecked>
                        <Binding Mode="OneWay" Path="IsBlurEnabled" />
                    </AppBarToggleButton.IsChecked>
                    <AppBarToggleButton.Command>
                        <Binding Path="ToggleBlurCommand" />
                    </AppBarToggleButton.Command>
                    <AppBarToggleButton.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEC26;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    x:Name="Settings"
                    x:Uid="SettingsButton"
                    Icon="Setting">
                    <ToolTipService.ToolTip>
                        <Binding Path="Label">
                            <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                            </Binding.RelativeSource>
                        </Binding>
                    </ToolTipService.ToolTip>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <renderer:EmulatorPanel
            x:Name="EmulatorPanel"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <renderer:EmulatorPanel.VideoMode>
                <Binding Path="VideoMode" />
            </renderer:EmulatorPanel.VideoMode>
            <renderer:EmulatorPanel.IsSoundEnabled>
                <Binding Path="IsSoundEnabled" />
            </renderer:EmulatorPanel.IsSoundEnabled>
            <renderer:EmulatorPanel.IsBlurEnabled>
                <Binding Path="IsBlurEnabled" />
            </renderer:EmulatorPanel.IsBlurEnabled>
            <renderer:EmulatorPanel.IsEmulationPaused>
                <Binding Path="IsSetupGamepadMode" />
            </renderer:EmulatorPanel.IsEmulationPaused>
        </renderer:EmulatorPanel>
        <Border Grid.RowSpan="2">
            <Border.Visibility>
                <Binding Converter="{StaticResource BoolToVisibilityConverter}" Path="IsGamePadEnabled" />
            </Border.Visibility>
            <gamepad:GamePadControl
                x:Name="GamePad"
                AccentColor="{StaticResource AccentColorBrush}">
                <gamepad:GamePadControl.Status>
                    <Binding Converter="{StaticResource BoolToGamepadEditingStatusConverter}" Path="IsSetupGamepadMode" />
                </gamepad:GamePadControl.Status>
                <gamepad:GamePadControl.Mode>
                    <Binding
                        Converter="{StaticResource EmulatorToGamePadeModeConverter}"
                        ElementName="EmulatorPanel"
                        Path="LoadedEmulator" />
                </gamepad:GamePadControl.Mode>
            </gamepad:GamePadControl>
        </Border>
        <SplitView
            x:Name="SettingsView"
            Grid.RowSpan="2"
            Canvas.ZIndex="20"
            DisplayMode="Overlay"
            IsTabStop="False"
            OpenPaneLength="340"
            PaneBackground="#FF00B2F0"
            PanePlacement="Right">
            <SplitView.Pane>
                <flyouts:BoxSettingsFlyout CloseClicked="Settings_CloseClicked" />
            </SplitView.Pane>
        </SplitView>
    </Grid>
</view:CommonPage>