<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UniversalEmulator'">
    <Content Include="$(MSBuildThisFileDirectory)..\native\libmboxpanels.dylib"
             Condition="Exists('$(MSBuildThisFileDirectory)..\native\libmboxpanels.dylib') and ($(RuntimeIdentifier) == '' or $(RuntimeIdentifier.StartsWith('osx')))">
      <Link>libmboxpanels.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\native\mboxpanels.dll"
             Condition="Exists('$(MSBuildThisFileDirectory)..\native\mboxpanels.dll') and ($(RuntimeIdentifier) == '' or $(RuntimeIdentifier.StartsWith('win')))">
      <Link>mboxpanels.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Original Store binaries on Windows: MBoxPanels.Original (host of NesboxPanels.dll / GameController.dll)
       goes into an "Original" folder next to the exe; the app loads it at runtime (MBoxPanels/Originals.cs). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UniversalEmulator'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)MBoxPanels.Contracts\MBoxPanels.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'UniversalEmulator'">
    <_WantOriginalHost Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win')))">true</_WantOriginalHost>
    <_OriginalHostOut>$(MSBuildThisFileDirectory)MBoxPanels.Original\bin\$(Configuration)\net10.0-windows10.0.19041.0\</_OriginalHostOut>
  </PropertyGroup>

  <Target Name="BuildOriginalHost" AfterTargets="Build" Condition="'$(_WantOriginalHost)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)MBoxPanels.Original\MBoxPanels.Original.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);_RestoreToken=$([System.Guid]::NewGuid())"
             RemoveProperties="RuntimeIdentifier;TargetFramework;PublishProfile;SelfContained;PublishSingleFile;PublishReadyToRun;PublishDir;Platform" />
    <ItemGroup>
      <_OriginalHostFiles Include="$(_OriginalHostOut)*.*" Exclude="$(_OriginalHostOut)*.pdb;$(_OriginalHostOut)MBoxPanels.Contracts.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OriginalHostFiles)" DestinationFolder="$(OutDir)Original" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishOriginalHost" AfterTargets="Publish" DependsOnTargets="BuildOriginalHost" Condition="'$(_WantOriginalHost)' == 'true'">
    <Copy SourceFiles="@(_OriginalHostFiles)" DestinationFolder="$(PublishDir)Original" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PackageMacAppBundle"
          AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'UniversalEmulator' and $(RuntimeIdentifier.StartsWith('osx')) and $([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_MacAppDir>$([System.IO.Path]::GetFullPath('$(PublishDir)..\UniversalEmulator.app'))</_MacAppDir>
      <_MacContentsDir>$(_MacAppDir)/Contents</_MacContentsDir>
      <_MacOSDir>$(_MacContentsDir)/MacOS</_MacOSDir>
      <_MacResDir>$(_MacContentsDir)/Resources</_MacResDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_MacAppDir)" />
    <MakeDir Directories="$(_MacOSDir);$(_MacResDir)" />
    <Exec Command="cp -R &quot;$(PublishDir).&quot; &quot;$(_MacOSDir)/&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Platforms\Desktop\Info.plist" DestinationFolder="$(_MacContentsDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Platforms\Desktop\AppIcon.icns" DestinationFolder="$(_MacResDir)" />
    <Exec Command="chmod +x &quot;$(_MacOSDir)/UniversalEmulator&quot; &amp;&amp; codesign --force --deep --sign - &quot;$(_MacAppDir)&quot;" />
  </Target>
</Project>

