<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls">
    <Style TargetType="RotatorTile">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RotatorTile">
                    <Grid Background="{TemplateBinding Background}">
                        <Canvas x:Name="Scroller">
                            <Canvas.DataContext>
                                <NullExtension />
                            </Canvas.DataContext>
                            <StackPanel x:Name="Stack">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="Translate" Y="0" />
                                </StackPanel.RenderTransform>
                                <ContentPresenter x:Name="Current">
                                    <ContentPresenter.DataContext>
                                        <NullExtension />
                                    </ContentPresenter.DataContext>
                                    <ContentPresenter.ContentTemplate>
                                        <TemplateBinding Property="ItemTemplate" />
                                    </ContentPresenter.ContentTemplate>
                                    <Binding />
                                </ContentPresenter>
                                <ContentPresenter x:Name="Next">
                                    <ContentPresenter.DataContext>
                                        <NullExtension />
                                    </ContentPresenter.DataContext>
                                    <ContentPresenter.ContentTemplate>
                                        <TemplateBinding Property="ItemTemplate" />
                                    </ContentPresenter.ContentTemplate>
                                    <Binding />
                                </ContentPresenter>
                            </StackPanel>
                        </Canvas>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>