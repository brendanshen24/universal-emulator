<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Microsoft.Toolkit.Uwp.UI.Controls">
    <Style TargetType="HamburgerMenu">
        <Setter Property="HamburgerMenuTemplate">
            <Setter.Value>
                <DataTemplate>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HamburgerMenu">
                    <Grid>
                        <SplitView x:Name="MainSplitView">
                            <SplitView.OpenPaneLength>
                                <TemplateBinding Property="OpenPaneLength" />
                            </SplitView.OpenPaneLength>
                            <SplitView.PanePlacement>
                                <TemplateBinding Property="PanePlacement" />
                            </SplitView.PanePlacement>
                            <SplitView.DisplayMode>
                                <TemplateBinding Property="DisplayMode" />
                            </SplitView.DisplayMode>
                            <SplitView.CompactPaneLength>
                                <TemplateBinding Property="CompactPaneLength" />
                            </SplitView.CompactPaneLength>
                            <SplitView.PaneBackground>
                                <TemplateBinding Property="PaneBackground" />
                            </SplitView.PaneBackground>
                            <SplitView.IsPaneOpen>
                                <TemplateBinding Property="IsPaneOpen" />
                            </SplitView.IsPaneOpen>
                            <SplitView.Pane>
                                <Grid x:Name="PaneGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.Height>
                                            <TemplateBinding Property="HamburgerHeight" />
                                        </Grid.Height>
                                    </Grid>
                                    <ListView
                                        x:Name="ButtonsListView"
                                        Grid.Row="1"
                                        IsItemClickEnabled="True"
                                        SelectionMode="Single">
                                        <ListView.ItemsSource>
                                            <TemplateBinding Property="ItemsSource" />
                                        </ListView.ItemsSource>
                                        <ListView.ItemTemplate>
                                            <TemplateBinding Property="ItemTemplate" />
                                        </ListView.ItemTemplate>
                                        <ListView.Width>
                                            <TemplateBinding Property="OpenPaneLength" />
                                        </ListView.Width>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0,0,0,0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                    <Grid Grid.Row="2">
                                        <Grid.Visibility>
                                            <TemplateBinding Property="OptionsVisibility" />
                                        </Grid.Visibility>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <ListView
                                            x:Name="OptionsListView"
                                            Grid.Row="1"
                                            VerticalAlignment="Bottom"
                                            IsItemClickEnabled="True">
                                            <ListView.ItemsSource>
                                                <TemplateBinding Property="OptionsItemsSource" />
                                            </ListView.ItemsSource>
                                            <ListView.ItemTemplate>
                                                <TemplateBinding Property="OptionsItemTemplate" />
                                            </ListView.ItemTemplate>
                                            <ListView.Width>
                                                <TemplateBinding Property="OpenPaneLength" />
                                            </ListView.Width>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0,0,0,0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </SplitView.Pane>
                            <ContentPresenter x:Name="ContentPart" Content="{TemplateBinding Content}" />
                        </SplitView>
                        <Button
                            x:Name="HamburgerButton"
                            Padding="0,0,0,0"
                            VerticalAlignment="Top"
                            Background="#00FFFFFF"
                            BorderThickness="0,0,0,0">
                            <Button.Width>
                                <TemplateBinding Property="HamburgerWidth" />
                            </Button.Width>
                            <Button.Height>
                                <TemplateBinding Property="HamburgerHeight" />
                            </Button.Height>
                            <ContentControl Foreground="{TemplateBinding Foreground}">
                                <ContentControl.ContentTemplate>
                                    <TemplateBinding Property="HamburgerMenuTemplate" />
                                </ContentControl.ContentTemplate>
                                <ContentControl.Margin>
                                    <TemplateBinding Property="HamburgerMargin" />
                                </ContentControl.Margin>
                            </ContentControl>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>