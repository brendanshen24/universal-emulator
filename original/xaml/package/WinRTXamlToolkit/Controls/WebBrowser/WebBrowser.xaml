<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinRTXamlToolkit.Controls"
    xmlns:converters="using:WinRTXamlToolkit.Converters"
    xmlns:Extensions="using:WinRTXamlToolkit.Controls.Extensions">
    <Style x:Key="UnlabeledAppBarButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AppBarItemForegroundThemeBrush}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="AutomationProperties.ItemType" Value="App Bar Button" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ApplicationViewStates">
                                <VisualState x:Name="FullScreenLandscape" />
                                <VisualState x:Name="Filled" />
                                <VisualState x:Name="FullScreenPortrait">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Width">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="60" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Snapped">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Width">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="60" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGlyph" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemPointerOverBackgroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemPointerOverForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutlineGlyph" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGlyph" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemPressedForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutlineGlyph" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemDisabledForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource AppBarItemDisabledForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusVisualWhite"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="00:00:00" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusVisualBlack"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="00:00:00" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid
                                Width="40"
                                Height="40"
                                Margin="0,12,0,11"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                                <TextBlock
                                    x:Name="BackgroundGlyph"
                                    Margin="-4,-19,0,0"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="53.333"
                                    Foreground="{StaticResource AppBarItemBackgroundThemeBrush}"
                                    Text="&#xE0A8;" />
                                <TextBlock
                                    x:Name="OutlineGlyph"
                                    Margin="-4,-19,0,0"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="53.333"
                                    Text="&#xE0A7;" />
                                <ContentPresenter
                                    x:Name="Content"
                                    Margin="-1,-1,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Rectangle
                            x:Name="FocusVisualWhite"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{StaticResource FocusVisualWhiteStrokeThemeBrush}"
                            StrokeDashArray="1,1"
                            StrokeDashOffset="1.5"
                            StrokeEndLineCap="Square" />
                        <Rectangle
                            x:Name="FocusVisualBlack"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{StaticResource FocusVisualBlackStrokeThemeBrush}"
                            StrokeDashArray="1,1"
                            StrokeDashOffset="0.5"
                            StrokeEndLineCap="Square" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="UnlabeledPreviousAppBarButtonStyle"
        BasedOn="{StaticResource UnlabeledAppBarButtonStyle}"
        TargetType="Button">
        <Setter Property="AutomationProperties.AutomationId" Value="PreviousAppBarButton" />
        <Setter Property="AutomationProperties.Name" Value="Previous" />
        <Setter Property="Content" Value="&#xE112;" />
    </Style>
    <Style
        x:Key="UnlabeledNextAppBarButtonStyle"
        BasedOn="{StaticResource UnlabeledAppBarButtonStyle}"
        TargetType="Button">
        <Setter Property="AutomationProperties.AutomationId" Value="NextAppBarButton" />
        <Setter Property="AutomationProperties.Name" Value="Next" />
        <Setter Property="Content" Value="&#xE111;" />
    </Style>
    <Style
        x:Key="UnlabeledNoAppBarButtonStyle"
        BasedOn="{StaticResource UnlabeledAppBarButtonStyle}"
        TargetType="Button">
        <Setter Property="AutomationProperties.AutomationId" Value="NoAppBarButton" />
        <Setter Property="AutomationProperties.Name" Value="No" />
        <Setter Property="Content" Value="&#xE10A;" />
    </Style>
    <Style
        x:Key="UnlabeledRefreshAppBarButtonStyle"
        BasedOn="{StaticResource UnlabeledAppBarButtonStyle}"
        TargetType="Button">
        <Setter Property="AutomationProperties.AutomationId" Value="RefreshAppBarButton" />
        <Setter Property="AutomationProperties.Name" Value="Refresh" />
        <Setter Property="Content" Value="&#xE117;" />
    </Style>
    <Style TargetType="controls:WebBrowser">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WebBrowser">
                    <Grid x:Name="PART_LayoutRoot">
                        <Grid.Resources>
                            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LoadingStates">
                                <VisualState x:Name="LoadingState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ProgressIndicator" Storyboard.TargetProperty="IsIndeterminate">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="True" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_StopButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RefreshButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_GoButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="LoadedState" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="AddressBarStates">
                                <VisualState x:Name="AddressBarFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_AddressBar" Storyboard.TargetProperty="Foreground">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource TextBoxForegroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_AddressBar" Storyboard.TargetProperty="Background">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{StaticResource TextBoxBackgroundThemeBrush}" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BackButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_FavIconImage" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FavIconBackground" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RefreshButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ForwardButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_GoButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="AddressBarUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_GoButton" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="Collapsed" />
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.Background>
                            <WebViewBrush x:Name="PART_WebViewBrush" SourceName="PART_WebView" />
                        </Grid.Background>
                        <WebView x:Name="PART_WebView" />
                        <controls:CustomAppBar
                            x:Name="PART_TitleAppBar"
                            VerticalAlignment="Top"
                            Extensions:FrameworkElementExtensions.ClipToBounds="True"
                            IsLightDismissEnabled="True">
                            <TextBlock
                                x:Name="PART_TitleBar"
                                Margin="6,6,6,6"
                                FontSize="24" />
                        </controls:CustomAppBar>
                        <controls:CustomAppBar
                            x:Name="PART_AddressAppBar"
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Extensions:FrameworkElementExtensions.ClipToBounds="True"
                            IsLightDismissEnabled="True"
                            IsOpen="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="41" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PART_BackButton"
                                    AutomationProperties.Name=""
                                    Style="{StaticResource UnlabeledPreviousAppBarButtonStyle}" />
                                <Border
                                    x:Name="FavIconBackground"
                                    Grid.Column="1"
                                    Width="41"
                                    Height="41"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ApplicationForegroundThemeBrush}"
                                    BorderThickness="0,0,0,0">
                                    <Image
                                        x:Name="PART_FavIconImage"
                                        Margin="4,4,4,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform" />
                                </Border>
                                <TextBox
                                    x:Name="PART_AddressBar"
                                    Grid.Column="2"
                                    MinHeight="32"
                                    Margin="0,5,0,5"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AppBarBackgroundThemeBrush}"
                                    FontSize="22"
                                    Foreground="{StaticResource AppBarItemForegroundThemeBrush}" />
                                <ProgressBar
                                    x:Name="PART_ProgressIndicator"
                                    Grid.Column="2"
                                    VerticalAlignment="Top" />
                                <Button
                                    x:Name="PART_GoButton"
                                    Grid.Column="3"
                                    AutomationProperties.Name=""
                                    Style="{StaticResource UnlabeledNextAppBarButtonStyle}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="PART_StopButton"
                                    Grid.Column="3"
                                    AutomationProperties.Name=""
                                    Style="{StaticResource UnlabeledNoAppBarButtonStyle}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="PART_RefreshButton"
                                    Grid.Column="3"
                                    AutomationProperties.Name=""
                                    Style="{StaticResource UnlabeledRefreshAppBarButtonStyle}" />
                                <Button
                                    x:Name="PART_ForwardButton"
                                    Grid.Column="4"
                                    AutomationProperties.Name=""
                                    Style="{StaticResource UnlabeledNextAppBarButtonStyle}" />
                            </Grid>
                        </controls:CustomAppBar>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>